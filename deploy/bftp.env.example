# Copy to deploy/bftp.env (kept out of git) and fill in.
# Loaded by the systemd unit via EnvironmentFile=.

BFTP_HOST=127.0.0.1
BFTP_PORT=8765

# The URL you'll actually use day-to-day to open the app — this is baked
# into OAuth redirect URIs for Spotify/TIDAL. Use your Tailnet HTTPS address
# since that's the gate-free path you'll use most:
#   https://<device>.<tailnet>.ts.net
# If you mostly use the public/basic-auth or custom-domain URL instead,
# set that here and register *that* as the redirect URI with Spotify/TIDAL.
BFTP_PUBLIC_URL=https://<device>.<tailnet>.ts.net

# Optional: absolute path for the SQLite DB. Defaults to ./data/library.db
# relative to the repo root.
# BFTP_DB_PATH=/opt/blastfromthepast/data/library.db
